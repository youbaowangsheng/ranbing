/* 我的名片 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
}
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  /* 顶部留白：与「我的发布」一致，使标题位于胶囊按钮下方 */
  padding-top: calc(var(--status-bar-height, 20px) + 70px);
  height: 44px;
  box-sizing: content-box;
  background: #1a3a5c;
  display: flex;
  align-items: center;
  z-index: 100;
}
.back-btn {
  color: #fff;
  font-size: 24px;
  padding: 0 12px;
}
.top-bar-title {
  flex: 1;
  text-align: center;
  color: #fff;
  font-size: 17px;
  font-weight: 500;
  padding-right: 36px;
}
.add-btn { color: #fff; font-size: 14px; padding: 0 16px; }

.card-list {
  padding: calc(var(--status-bar-height, 20px) + 130px) 16px 20px;
}
.loading { text-align: center; color: #888; font-size: 14px; padding: 40px 0; }
.empty { text-align: center; color: #999; font-size: 14px; padding: 60px 0; }

/* ── 名片主体 ── */
.biz-card {
  background: linear-gradient(135deg, #1a3a5c 0%, #2d5a8a 100%);
  border-radius: 16px;
  padding: 22px 20px 18px;
  box-shadow: 0 6px 20px rgba(26,58,92,0.25);
  margin-bottom: 14px;
}
.biz-card-head { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
.biz-avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 24px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.biz-name-wrap { flex: 1; min-width: 0; }
.biz-name { font-size: 20px; font-weight: 700; color: #fff; margin-bottom: 4px; }
.biz-title { font-size: 13px; color: rgba(255,255,255,0.75); }
.biz-cert {
  font-size: 11px;
  color: #1a3a5c;
  background: #ffd666;
  padding: 2px 8px;
  border-radius: 10px;
  flex-shrink: 0;
}

.biz-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
.biz-tag {
  font-size: 11px;
  color: #fff;
  background: rgba(255,255,255,0.18);
  padding: 3px 10px;
  border-radius: 10px;
}

.biz-info {
  background: rgba(255,255,255,0.1);
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 16px;
}
.biz-row { display: flex; margin-bottom: 8px; }
.biz-row:last-child { margin-bottom: 0; }
.biz-label { font-size: 12px; color: rgba(255,255,255,0.6); width: 44px; flex-shrink: 0; }
.biz-value { font-size: 13px; color: #fff; flex: 1; line-height: 1.5; }

.biz-actions { display: flex; gap: 10px; }
.biz-btn {
  flex: 1;
  text-align: center;
  font-size: 14px;
  padding: 10px 0;
  border-radius: 20px;
}
.biz-btn.primary { background: #e86a3a; color: #fff; font-weight: 600; }
.biz-btn:active { opacity: 0.85; }

.tip { text-align: center; font-size: 12px; color: #aaa; padding: 8px 20px; }
