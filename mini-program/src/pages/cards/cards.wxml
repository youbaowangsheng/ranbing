<view class="page">
  <view class="top-bar">
    <view class="back-btn" bindtap="goBack">‹</view>
    <text class="top-bar-title">我的名片</text>
    <view class="add-btn" bindtap="editCard">编辑</view>
  </view>

  <view class="card-list">
    <view wx:if="{{loading}}" class="loading">加载中...</view>

    <block wx:elif="{{profile}}">
      <!-- 名片主体：展示个人资料 -->
      <view class="biz-card">
        <view class="biz-card-head">
          <view class="biz-avatar">{{avatarChar}}</view>
          <view class="biz-name-wrap">
            <view class="biz-name">{{profile.real_name || '未命名'}}</view>
            <view class="biz-title">
              {{profile.company || '未填写公司'}}{{profile.position ? ' · ' + profile.position : ''}}
            </view>
          </view>
          <view class="biz-cert" wx:if="{{profile.cert_level >= 2}}">已认证</view>
        </view>

        <view class="biz-tags" wx:if="{{tags.length > 0}}">
          <text class="biz-tag" wx:for="{{tags}}" wx:key="index">{{item}}</text>
        </view>

        <view class="biz-info">
          <view class="biz-row" wx:if="{{profile.industry}}">
            <text class="biz-label">行业</text>
            <text class="biz-value">{{profile.industry}}</text>
          </view>
          <view class="biz-row" wx:if="{{profile.city}}">
            <text class="biz-label">城市</text>
            <text class="biz-value">{{profile.city}}</text>
          </view>
          <view class="biz-row" wx:if="{{profile.education_school}}">
            <text class="biz-label">院校</text>
            <text class="biz-value">{{profile.education_school}}{{profile.education_year ? ' ' + profile.education_year + '届' : ''}}</text>
          </view>
          <view class="biz-row" wx:if="{{profile.bio}}">
            <text class="biz-label">简介</text>
            <text class="biz-value">{{profile.bio}}</text>
          </view>
        </view>

        <view class="biz-actions">
          <view class="biz-btn primary" bindtap="editCard">编辑资料</view>
        </view>
      </view>

      <view class="tip">名片内容来自「个人资料」，编辑后会同步更新</view>
    </block>

    <view wx:else class="empty">
      <text>资料加载失败，请下拉重试</text>
    </view>
  </view>
</view>
