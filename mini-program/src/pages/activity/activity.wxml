<!-- 活动列表 -->
<view class="container">
  <!-- 标题栏：与胶囊按钮同高度 -->
  <view class="nav-title-bar" style="padding-top: {{statusBarHeight}}px; height: {{menuBtnHeight}}px;">
    <text class="nav-title">活动</text>
  </view>
  <view class="top-bar">
    <view class="search-box">
      <image class="icon-search" src="/assets/icons/search-white.png" mode="aspectFit" />
      <input class="search-input" placeholder="搜索活动" value="{{keyword}}" bindinput="onKeywordInput" />
    </view>
    <view class="ai-btn" bindtap="toAiAssistant"><image class="icon-ai" src="/assets/icons/ai.png" mode="aspectFit" /><text>AI</text></view>
  </view>

  <!-- Tab -->
  <view class="tab-bar">
    <view class="tab {{activeTab==='recommend'?'active':''}}" data-tab="recommend" bindtap="switchTab">推荐</view>
    <view class="tab {{activeTab==='upcoming'?'active':''}}" data-tab="upcoming" bindtap="switchTab">即将举办</view>
    <view class="tab {{activeTab==='past'?'active':''}}" data-tab="past" bindtap="switchTab">往期回顾</view>
    <view class="tab {{activeTab==='mine'?'active':''}}" data-tab="mine" bindtap="switchTab" wx:if="{{loggedIn}}">我参与的</view>
  </view>

  <view class="loading" wx:if="{{loading}}"><text>加载中...</text></view>

  <!-- AI精选区 -->
  <view class="ai-section" wx:if="{{!aiLoading && aiItem && activeTab==='recommend'}}">
    <view class="ai-label"><image class="icon-sparkle" src="/assets/icons/sparkle.png" mode="aspectFit" /><text>AI精选</text><text class="ai-gen-badge">人工智能生成</text></view>
    <view class="ai-card" bindtap="toDetail" data-uuid="{{aiItem.uuid}}">
      <view class="ai-match-row">
        <view class="match-pill"><image class="icon-fire" src="/assets/icons/fire.png" mode="aspectFit" /><text>{{aiItem.pct}}%匹配</text></view>
        <text class="match-reason">{{aiItem.match_reason}}</text>
      </view>
      <view class="ai-card-title">{{aiItem.title}}</view>
      <view class="ai-card-meta"><image class="icon-meta" src="/assets/icons/calendar.png" mode="aspectFit" /><text>{{aiItem.start_time_fmt}}</text><image class="icon-meta" src="/assets/icons/location.png" mode="aspectFit" /><text>{{aiItem.location}}</text></view>
      <view class="ai-card-footer">
        <text class="ai-card-attend">{{aiItem.attendee_count || 0}}人已报名</text>
        <text class="ai-card-tag" wx:for="{{aiItem.tags}}" wx:key="id" wx:for-item="t">#{{t.name}}</text>
      </view>
    </view>
  </view>

  <!-- 分类筛栏 -->
  <view class="category-scroll">
    <text class="cat-chip {{activeCat==='全部'?'active':''}}" data-cat="全部" bindtap="selectCat">全部</text>
    <text class="cat-chip {{activeCat===cat?'active':''}}" wx:for="{{categories}}" wx:key="index" data-cat="{{cat}}" bindtap="selectCat">{{cat}}</text>
  </view>

  <!-- 活动列表 -->
  <view class="event-list" wx:if="{{!loading}}">
    <view class="event-card" wx:for="{{items}}" wx:key="uuid" bindtap="toDetail" data-uuid="{{item.uuid}}">
      <view class="event-thumb" style="background: {{item.cover_color || '#1a3a5c'}}">
        <image class="icon-event-cover" src="/assets/icons/target-white.png" mode="aspectFit" />
        <view class="event-label" wx:if="{{item.status===2}}">回顾</view>
      </view>
      <view class="event-info">
        <view class="event-title">{{item.title}}</view>
        <view class="event-meta"><image class="icon-meta" src="/assets/icons/calendar.png" mode="aspectFit" /><text>{{item.start_time_fmt}}</text><image class="icon-meta" src="/assets/icons/location.png" mode="aspectFit" /><text>{{item.location}}</text></view>
        <view class="event-meta"><image class="icon-meta" src="/assets/icons/users.png" mode="aspectFit" /><text>{{item.attendee_count}}人报名</text></view>
        <view class="event-tags">
          <text wx:for="{{item.tags}}" wx:key="id" wx:for-item="t" class="e-tag">#{{t.name}}</text>
        </view>
      </view>
    </view>
    <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore"><text>{{loadingMore?'加载中...':'加载更多'}}</text></view>
    <view class="no-more" wx:if="{{!hasMore && items.length>0}}"><text>— 没有更多了 —</text></view>
    <view class="empty" wx:if="{{!loading && items.length===0}}"><image class="icon-empty" src="/assets/icons/event.png" mode="aspectFit" /><text style="display:block;margin-top:12px;color:#999;font-size:14px;">暂无活动</text></view>
  </view>
</view>